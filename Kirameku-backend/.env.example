# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Application secret
SECRET_KEY=your-secret-key

# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://your-domain.com

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
GITEE_ACCESS_TOKEN=

# Local uploads
# Relative paths are resolved from Kirameku-backend/.
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
MAX_DOWNLOAD_FILE_SIZE=524288000

# Bangumi metadata API mirror (optional)
BANGUMI_API_URL=https://api.bgmapi.com
BANGUMI_IMAGE_URL=https://api.bgmapi.com
